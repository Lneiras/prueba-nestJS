# Copia este archivo como .env y ajusta los valores:
#   cp .env.example .env
#
# En tu PC estos valores sirven tal cual (con docker-compose.yml o con npm run start:dev).
# En AWS (EC2 + RDS) el .env cambia: ver la sección "AWS" del README.

# Puerto donde corre la API
PORT=3000

# Conexión a PostgreSQL
# - En local: la base corre en Docker y se ve en localhost.
# - En AWS: DB_HOST es el "Endpoint" de tu base RDS (termina en .rds.amazonaws.com).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password-ficticia
DB_NAME=proyecto

# RDS con PostgreSQL 15 o superior exige conexión cifrada: en AWS pon DB_SSL=true.
# En local déjalo en false.
DB_SSL=false
