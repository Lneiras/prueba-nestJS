
# Puerto donde corre la API
PORT=3000

# Conexión a PostgreSQL
# - En local: la base corre en Docker y se ve en localhost.
# - En AWS: pon aquí el endpoint de RDS, con el formato <instancia>.<id>.<region>.rds.amazonaws.com
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambia-esta-contraseña
DB_NAME=proyecto

# En AWS pon DB_SSL=true.
# En local false.
DB_SSL=false

# Clave para firmar los tokens JWT. Usa una cadena larga y aleatoria en producción.
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_IN=1h

# Claves para el endpoint externo (x-api-key), separadas por coma.
API_KEYS=clave1,clave2
